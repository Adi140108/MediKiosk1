# MediKiosk Environment Configuration Template

# Core Application Settings
APP_NAME=MediKiosk
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=replace_with_a_secure_random_key_in_production

# Cloudinary (Patient and document image uploads only)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=MediKiosk

# Backblaze B2 (Private encrypted document & PDF storage)
B2_BUCKET_ID=your_b2_bucket_id
B2_KEY_ID=your_b2_application_key_id
B2_KEY_NAME=medikiosk-backend
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=medikiosk-documents
B2_ENDPOINT_URL=https://s3.us-west-005.backblazeb2.com

# Firestore Database Settings
FIRESTORE_PROJECT_ID=medikiosk1-cefd5
FIRESTORE_DATABASE_ID=(default)
USE_MOCK_FIRESTORE_IN_DEV=True

# Gemma 4 12B / Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma4:12b
GEMMA_TEMPERATURE=0.2
GEMMA_REQUEST_TIMEOUT=45

# AI4Bharat Indic Speech & Translation Suite
AI4BHARAT_MODE=auto  # "local" (self-hosted weights), "api" (cloud endpoints), or "auto"
LOCAL_INDICTRANS_PATH=./models/indictrans2
LOCAL_INDIC_DEVICE=auto  # "cuda", "cpu", or "auto"
LOCAL_INDIC_COMPUTE_TYPE=auto  # "int8", "float16", "float32", or "auto"
AI4BHARAT_API_KEY=your_ai4bharat_api_key_here
AI4BHARAT_BASE_URL=https://api.ai4bharat.org
DEFAULT_LANGUAGE=en

# Socratic Intake Configuration
MAX_INTAKE_QUESTIONS=12
MIN_INTAKE_QUESTIONS=4
CONFIDENCE_THRESHOLD_STOP=0.85
