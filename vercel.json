{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "frontend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/physician",
      "destination": "/api/index.py"
    },
    {
      "source": "/physician/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/diagnostics",
      "destination": "/api/index.py"
    },
    {
      "source": "/diagnostics/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/css/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/js/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/logo.png",
      "destination": "/api/index.py"
    },
    {
      "source": "/favicon.ico",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
