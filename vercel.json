{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/physician",
      "destination": "/physician.html"
    },
    {
      "source": "/physician/(.*)",
      "destination": "/physician.html"
    },
    {
      "source": "/diagnostics",
      "destination": "/diagnostics.html"
    },
    {
      "source": "/diagnostics/(.*)",
      "destination": "/diagnostics.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
